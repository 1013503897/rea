@@ -0,0 +1,80 @@
+//! One read-only interpretation of native value and operation identities.
+use crate::{
+    context::{OpId, VarnodeId},
+    funcdata::Funcdata,
+};
+use serde::Serialize;
+use slotmap::Key;
+use std::collections::BTreeSet;
+
+pub struct TextBudget {
+    used: usize,
+    limit: usize,
+}
+impl TextBudget {
+    pub fn new(limit: usize) -> Self {
+        Self { used: 0, limit }
+    }
+    pub fn charge(&mut self, bytes: usize) -> Result<(), String> {
+        let next = self
+            .used
+            .checked_add(bytes)
+            .ok_or("atomic text count overflow")?;
+        if next > self.limit {
+            return Err("atomic text capacity exceeded".into());
+        }
+        self.used = next;
+        Ok(())
+    }
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct ValueFact {
+    pub id: String,
+    pub space: Option<String>,
+    pub offset: String,
+    pub size_bytes: i32,
+    pub is_constant: bool,
+    pub is_input: bool,
+    pub is_annotation: bool,
+    pub definition: Option<String>,
+    pub type_name: String,
+}
+pub fn value_id(id: VarnodeId) -> String {
+    format!("v{:x}", id.data().as_ffi())
+}
+pub fn operation_id(fd: &Funcdata, id: OpId) -> Result<String, String> {
+    let operation = fd.obank().get(id).ok_or("stale operation identity")?;
+    let seq = operation.get_seq_num();
+    Ok(format!(
+        "0x{:x}:{:x}",
+        seq.get_addr().get_offset(),
+        seq.get_time()
+    ))
+}
+pub fn collect(
+    fd: &Funcdata,
+    keys: BTreeSet<VarnodeId>,
+    text: &mut TextBudget,
+) -> Result<Vec<ValueFact>, String> {
+    let mut values = Vec::with_capacity(keys.len());
+    for key in keys {
+        let value = fd.vbank().get(key).ok_or("stale input/output value")?;
+        let type_name = value.get_type().get_name();
+        text.charge(type_name.len())?;
+        values.push(ValueFact {
+            id: value_id(key),
+            space: value
+                .get_addr()
+                .get_space()
+                .map(|s| s.get_name().to_string()),
+            offset: format!("0x{:x}", value.get_offset()),
+            size_bytes: value.get_size(),
+            is_constant: value.is_constant(),
+            is_input: value.is_input(),
+            is_annotation: value.is_annotation(),
+            definition: value.get_def().map(|id| operation_id(fd, id)).transpose()?,
+            type_name: type_name.to_string(),
+        });
+    }
+    Ok(values)
+}
