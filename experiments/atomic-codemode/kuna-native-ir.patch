index 00000000..08deb2e5
--- /dev/null
+++ b/decompiler/crates/kuna-cli/src/atomic_json.rs
@@ -0,0 +1,497 @@
+//! Opt-in atomic documents share the ordinary record producer and JSON writer.
+//! A graph that cannot fit must not discard otherwise readable reconstructed C.
+
+use crate::jsonfmt::{dumps_compact_bounded, Json};
+
+// Ownership is moved out while trying bounded alternatives, never cloned.
+struct RemovedFacet {
+    function: usize,
+    value: (String, Json),
+    added_error: bool,
+}
+// JSON object member order is not facet identity. Restore owned entries by key,
+// never by an ordinal invalidated when another independent facet was removed.
+#[derive(Clone, Copy)]
+enum Omission {
+    Capacity,
+    RedundantWithGraph,
+}
+fn function_records(document: &mut Json) -> Option<&mut Vec<Json>> {
+    let Json::Object(fields) = document else {
+        return None;
+    };
+    let (_, value) = fields.iter_mut().find(|(key, _)| key == "functions")?;
+    let Json::Array(functions) = value else {
+        return None;
+    };
+    Some(functions)
+}
+fn take_facet(document: &mut Json, name: &str, limit: usize, why: Omission) -> Vec<RemovedFacet> {
+    let mut removed = Vec::new();
+    if let Some(functions) = function_records(document) {
+        for (function, record) in functions.iter_mut().enumerate() {
+            if let Json::Object(fields) = record {
+                if matches!(why, Omission::RedundantWithGraph)
+                    && !fields.iter().any(|(key, _)| key == "atomic_facts")
+                {
+                    continue;
+                }
+                if let Some(field) = fields.iter().position(|(key, _)| key == name) {
+                    let value = fields.remove(field);
+                    let error = format!("{name}_error");
+                    let added_error = matches!(why, Omission::Capacity)
+                        && !fields.iter().any(|(key, _)| key == &error);
+                    if added_error {
+                        fields.push((error, Json::Str(format!("atomic encoded document exceeds {limit} byte capacity; {name} omitted, code retained"))));
+                    }
+                    removed.push(RemovedFacet {
+                        function,
+                        value,
+                        added_error,
+                    });
+                }
+            }
+        }
+    }
+    removed
+}
+fn restore_facet(document: &mut Json, removed: Vec<RemovedFacet>) {
+    if let Some(functions) = function_records(document) {
+        for facet in removed {
+            if let Json::Object(fields) = &mut functions[facet.function] {
+                if facet.added_error {
+                    let error = format!("{}_error", facet.value.0);
+                    fields.retain(|(key, _)| key != &error);
+                }
+                fields.push(facet.value);
+            }
+        }
+    }
+}
+struct GraphAlternative {
+    function: usize,
+    value: Json,
+}
+fn compress_graphs(document: &mut Json, budget: usize) -> Vec<GraphAlternative> {
+    let mut originals = Vec::new();
+    let mut remaining = budget;
+    if let Some(functions) = function_records(document) {
+        for (function, record) in functions.iter_mut().enumerate() {
+            if let Json::Object(fields) = record {
+                if let Some((_, graph)) = fields.iter_mut().find(|(key, _)| key == "atomic_facts") {
+                    if let Some((encoded, size)) =
+                        crate::atomic_compression::encode(graph, remaining)
+                    {
+                        remaining -= size;
+                        originals.push(GraphAlternative {
+                            function,
+                            value: std::mem::replace(graph, encoded),
+                        });
+                    }
+                }
+            }
+        }
+    }
+    originals
+}
+fn exchange_graphs(
+    document: &mut Json,
+    alternatives: Vec<GraphAlternative>,
+) -> Vec<GraphAlternative> {
+    let mut previous = Vec::new();
+    if let Some(functions) = function_records(document) {
+        for alternative in alternatives {
+            if let Json::Object(fields) = &mut functions[alternative.function] {
+                if let Some((_, graph)) = fields.iter_mut().find(|(key, _)| key == "atomic_facts") {
+                    previous.push(GraphAlternative {
+                        function: alternative.function,
+                        value: std::mem::replace(graph, alternative.value),
+                    });
+                }
+            }
+        }
+    }
+    previous
+}
+fn bounded(document: &Json, budget: usize) -> Option<String> {
+    let mut text = dumps_compact_bounded(document, budget)?;
+    text.push('\n');
+    Some(text)
+}
+// Reclaim a saved independent facet when other omissions have made room.
+// Only bounded encoded strings coexist here, never cloned graph/facet trees.
+fn reclaim(document: &mut Json, budget: usize, name: &str, saved: &mut Vec<RemovedFacet>, base: String) -> String {
+    if saved.is_empty() { return base; }
+    restore_facet(document, std::mem::take(saved));
+    if let Some(complete) = bounded(document, budget) { return complete; }
+    *saved = take_facet(document, name, budget + 1, Omission::Capacity);
+    base
+}
+fn bounded_reclaiming(document: &mut Json, budget: usize, name: &str, saved: &mut Vec<RemovedFacet>) -> Option<String> {
+    let base = bounded(document, budget)?;
+    Some(reclaim(document, budget, name, saved, base))
+}
+pub(crate) fn render(mut document: Json, limit: usize) -> Result<String, String> {
+    let budget = limit
+        .checked_sub(1)
+        .ok_or("atomic JSON output budget is zero")?;
+    // A newly added independent facet must not displace established graph/call
+    // coverage. Reclaim it only after the existing owner selects a fitting result.
+    let mut parameters = take_facet(&mut document, "atomic_parameters", limit, Omission::Capacity);
+    // A full graph already owns these operation/value facts. Keep its bounded
+    // projection aside in case encoded size later makes that graph unavailable.
+    let projection = take_facet(
+        &mut document,
+        "atomic_projection",
+        limit,
+        Omission::RedundantWithGraph,
+    );
+    if let Some(text) = bounded(&document, budget) {
+        return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+    }
+    let originals = compress_graphs(&mut document, budget);
+    let mut alternatives = if originals.is_empty() {
+        Vec::new()
+    } else {
+        if let Some(text) = bounded(&document, budget) {
+            return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+        }
+        exchange_graphs(&mut document, originals)
+    };
+    // New switch rows must not displace previously available graph/call facts.
+    // Retry without that independent facet before weakening existing coverage.
+    let mut switches = take_facet(&mut document, "atomic_switches", limit, Omission::Capacity);
+    if !switches.is_empty() {
+        if let Some(text) = bounded(&document, budget) {
+            return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+        }
+        if !alternatives.is_empty() {
+            let originals = exchange_graphs(&mut document, alternatives);
+            if let Some(text) = bounded(&document, budget) {
+                return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+            }
+            alternatives = exchange_graphs(&mut document, originals);
+        }
+    }
+    let calls = take_facet(&mut document, "atomic_calls", limit, Omission::Capacity);
+    if !calls.is_empty() {
+        if let Some(text) =
+            bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+        {
+            return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+        }
+        if !alternatives.is_empty() {
+            drop(exchange_graphs(&mut document, alternatives));
+            if let Some(text) =
+                bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+            {
+                return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+            }
+        }
+    }
+    restore_facet(&mut document, calls);
+    take_facet(&mut document, "atomic_facts", limit, Omission::Capacity);
+    restore_facet(&mut document, projection);
+    restore_facet(&mut document, std::mem::take(&mut switches));
+    if let Some(text) = bounded(&document, budget) {
+        return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+    }
+    switches = take_facet(&mut document, "atomic_switches", limit, Omission::Capacity);
+    if !switches.is_empty() {
+        if let Some(text) = bounded(&document, budget) {
+            return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+        }
+    }
+    // Independent calls retain priority when the combined fallback is too big.
+    let projection = take_facet(
+        &mut document,
+        "atomic_projection",
+        limit,
+        Omission::Capacity,
+    );
+    if let Some(text) = bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+    {
+        return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+    }
+    restore_facet(&mut document, projection);
+    take_facet(&mut document, "atomic_calls", limit, Omission::Capacity);
+    if let Some(text) = bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+    {
+        return Ok(reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text));
+    }
+    take_facet(
+        &mut document,
+        "atomic_projection",
+        limit,
+        Omission::Capacity,
+    );
+    bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+        .map(|text| reclaim(&mut document, budget, "atomic_parameters", &mut parameters, text)).ok_or_else(|| {
+        format!("atomic JSON exceeds {limit} byte capacity even without recovered facets")
+    })
+}
+
+#[cfg(test)]
+mod switch_facet_tests {
+    use super::*;
+    fn document(graph: usize, calls: usize, projection: usize, switches: usize) -> Json {
+        Json::Object(vec![(
+            "functions".into(),
+            Json::Array(vec![Json::Object(vec![
+                ("code".into(), Json::Str("retained C".into())),
+                ("atomic_facts".into(), Json::Str("g".repeat(graph))),
+                ("atomic_calls".into(), Json::Str("c".repeat(calls))),
+                (
+                    "atomic_projection".into(),
+                    Json::Str("p".repeat(projection)),
+                ),
+                ("atomic_switches".into(), Json::Str("s".repeat(switches))),
+            ])]),
+        )])
