+//! AArch64 PLT entry identity, shared by section and PT_DYNAMIC scans.
+//!
+//! Recognize the complete standard GNU/LLVM veneer, with optional BTI c and
+//! AUTIA1716 as described in Arm's System V ABI, "Sample PLT sequences":
+//! https://github.com/ARM-software/abi-aa/blob/main/sysvabi64/sysvabi64.rst#sample-plt-sequences
+//! Correlate the decoded GOT slot with the relocation owner in the parent.
+//! Prefixes belong to the entry; the ADRP's own PC supplies the page. An
+//! ordinary preceding instruction is never absorbed into the entry. Other
+//! veneer forms remain unrecognized rather than inheriting a guessed name.
+
+use std::collections::{HashMap, HashSet};
+
+use super::{record, PltSym};
+
+const BTI_C: u32 = 0xd503245f;
+const AUTIA1716: u32 = 0xd503219f;
+const BR_X17: u32 = 0xd61f0220;
+
+fn word(data: &[u8], off: usize) -> Option<u32> {
+    let bytes = data.get(off..)?.get(..4)?;
+    Some(u32::from_le_bytes(bytes.try_into().ok()?))
+}
+
+pub(super) fn decode(
+    vma: u64,
+    data: &[u8],
+    map: &HashMap<u64, Vec<u8>>,
+    out: &mut Vec<PltSym>,
+    named_got: &mut HashSet<u64>,
+) {
+    if vma & 3 != 0 {
+        return;
+    }
+    for off in (0..data.len()).step_by(4) {
+        let Some(adrp) = word(data, off) else { break };
+        // ADRP X16, page; opcode plus destination, with both immediate fields free.
+        if adrp & 0x9f00001f != 0x90000010 {
+            continue;
+        }
+        let body = &data[off..];
+        let Some(ldr) = word(body, 4) else { continue };
+        // LDR X17,[X16,#imm12*8], not a 32-bit load, another register or a call.
+        if ldr & 0xffc003ff != 0xf9400211 {
+            continue;
+        }
+        let lo = ((ldr >> 10) & 0xfff) * 8;
+        // The ADD must form exactly the same GOT slot for the lazy resolver
+        // (and for PAC's modifier); neither an unrelated load nor an incomplete
+        // ADRP/LDR pair establishes an imported function.
+        if lo > 0xfff || word(body, 8) != Some(0x91000210 | (lo << 10)) {
+            continue;
+        }
+        let transfer = if word(body, 12) == Some(AUTIA1716) {
+            16
+        } else {
+            12
+        };
+        if word(body, transfer) != Some(BR_X17) {
+            continue;
+        }
+        let Some(adrp_addr) = vma.checked_add(off as u64) else {
+            break;
+        };
+        if adrp_addr.checked_add(transfer as u64 + 3).is_none() {
+            continue;
+        }
+        let imm21 = (((adrp >> 5) & 0x7ffff) << 2) | ((adrp >> 29) & 3);
+        let pages = ((imm21 as i32) << 11 >> 11) as i64;
+        let got = (adrp_addr & !0xfff)
+            .wrapping_add((pages << 12) as u64)
+            .wrapping_add(lo as u64);
+        let prefix = off.checked_sub(4).and_then(|at| word(data, at)) == Some(BTI_C);
+        let entry = if prefix { adrp_addr - 4 } else { adrp_addr };
+        record(entry, got, map, out, named_got);
+    }
+}
+
