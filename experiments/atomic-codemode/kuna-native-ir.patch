+impl From<serde_json::Value> for Json {
+    fn from(value: serde_json::Value) -> Self {
+        match value {
+            serde_json::Value::Null => Json::Null,
+            serde_json::Value::Bool(value) => Json::Bool(value),
+            serde_json::Value::Number(value) => Json::Number(value.to_string()),
+            serde_json::Value::String(value) => Json::Str(value),
+            serde_json::Value::Array(values) => Json::Array(values.into_iter().map(Json::from).collect()),
+            serde_json::Value::Object(values) => Json::Object(values.into_iter().map(|(key, value)| (key, Json::from(value))).collect()),
+        }
+    }
+}
