@@ -0,0 +1,122 @@
+//! Bounded lossless wire encoding of logical schema-3 atomic graphs.
+use crate::jsonfmt::{dumps_compact_bounded, Json};
+use base64::{engine::general_purpose::STANDARD, Engine as _};
+use flate2::{write::GzEncoder, Compression};
+use std::io::{self, Write};
+
+const MAX_RAW_BYTES: usize = 32 * 1024 * 1024;
+struct BoundedBytes {
+    data: Vec<u8>,
+    limit: usize,
+}
+impl Write for BoundedBytes {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        let next = self
+            .data
+            .len()
+            .checked_add(bytes.len())
+            .filter(|n| *n <= self.limit)
+            .ok_or_else(|| io::Error::other("atomic compression capacity exceeded"))?;
+        if next > self.data.capacity() {
+            let capacity = next
+                .max(self.data.capacity().saturating_mul(2))
+                .min(self.limit);
+            self.data
+                .try_reserve_exact(capacity - self.data.len())
+                .map_err(|_| io::Error::other("atomic compression allocation failed"))?;
+        }
+        self.data.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+pub(crate) fn encode(graph: &Json, limit: usize) -> Option<(Json, usize)> {
+    let Json::Object(fields) = graph else {
+        return None;
+    };
+    if !fields
+        .iter()
+        .any(|(key, v)| key == "schema_version" && *v == Json::Number("3".into()))
+    {
+        return None;
+    }
+    let raw = dumps_compact_bounded(graph, MAX_RAW_BYTES)?;
+    let mut envelope = Json::Object(vec![
+        ("schema_version".into(), Json::Number("4".into())),
+        ("encoding".into(), Json::Str("gzip-base64".into())),
+        ("raw_bytes".into(), Json::Number(raw.len().to_string())),
+        ("data".into(), Json::Str(String::new())),
+    ]);
+    let overhead = dumps_compact_bounded(&envelope, limit)?.len();
+    let payload_limit = limit.checked_sub(overhead)?;
+    let compressed_limit = (payload_limit / 4).checked_mul(3)?;
+    let mut gzip = GzEncoder::new(
+        BoundedBytes {
+            data: Vec::new(),
+            limit: compressed_limit,
+        },
+        Compression::fast(),
+    );
+    gzip.write_all(raw.as_bytes()).ok()?;
+    let compressed = gzip.finish().ok()?.data;
+    let encoded_len = compressed
+        .len()
+        .checked_add(2)?
+        .checked_div(3)?
+        .checked_mul(4)?;
+    if encoded_len > payload_limit {
+        return None;
+    }
+    let encoded = STANDARD.encode(compressed);
+    if let Json::Object(fields) = &mut envelope {
+        let (_, data) = fields.iter_mut().find(|(key, _)| key == "data")?;
+        *data = Json::Str(encoded);
+    }
+    Some((envelope, overhead + encoded_len))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Read;
+    #[test]
+    fn lossless_frame_accounts_for_escaping_and_base64_expansion() {
+        let graph = Json::Object(vec![
+            ("schema_version".into(), Json::Number("3".into())),
+            ("statement".into(), Json::Str("中文😀\0".repeat(1000))),
+        ]);
+        let (encoded, size) = encode(&graph, 2000).unwrap();
+        let text = dumps_compact_bounded(&encoded, 2000).unwrap();
+        assert_eq!(text.len(), size);
+        let frame: serde_json::Value = serde_json::from_str(&text).unwrap();
+        let bytes = STANDARD.decode(frame["data"].as_str().unwrap()).unwrap();
+        let mut restored = String::new();
+        flate2::read::GzDecoder::new(bytes.as_slice())
+            .read_to_string(&mut restored)
+            .unwrap();
+        assert_eq!(
+            restored,
+            dumps_compact_bounded(&graph, MAX_RAW_BYTES).unwrap()
+        );
+        assert_eq!(frame["raw_bytes"].as_u64().unwrap(), restored.len() as u64);
+        assert!(encode(&graph, 1).is_none());
+        assert!(encode(&graph, size - 1).is_none());
+    }
+    #[test]
+    fn archive_is_single_layer_and_raw_allocation_has_an_independent_bound() {
+        assert!(encode(&Json::Str("not a graph".into()), 1000).is_none());
+        let nested = Json::Object(vec![("schema_version".into(), Json::Number("4".into()))]);
+        assert!(encode(&nested, 1000).is_none());
+        let oversized = Json::Object(vec![
+            ("schema_version".into(), Json::Number("3".into())),
+            (
+                "statement".into(),
+                Json::Str("\0".repeat(MAX_RAW_BYTES / 6 + 1)),
+            ),
+        ]);
+        assert!(encode(&oversized, 1000).is_none());
+    }
+}
diff --git a/decompiler/crates/kuna-cli/src/atomic_json.rs b/decompiler/crates/kuna-cli/src/atomic_json.rs
new file mode 100644
index 00000000..6005472b
--- /dev/null
+++ b/decompiler/crates/kuna-cli/src/atomic_json.rs
@@ -0,0 +1,456 @@
+//! Opt-in atomic documents share the ordinary record producer and JSON writer.
+//! A graph that cannot fit must not discard otherwise readable reconstructed C.
+
+use crate::jsonfmt::{dumps_compact_bounded, Json};
+
+// Ownership is moved out while trying bounded alternatives, never cloned.
+struct RemovedFacet {
+    function: usize,
+    field: usize,
+    value: (String, Json),
+    added_error: bool,
+}
+#[derive(Clone, Copy)]
+enum Omission {
+    Capacity,
+    RedundantWithGraph,
+}
+fn function_records(document: &mut Json) -> Option<&mut Vec<Json>> {
+    let Json::Object(fields) = document else {
+        return None;
+    };
+    let (_, value) = fields.iter_mut().find(|(key, _)| key == "functions")?;
+    let Json::Array(functions) = value else {
+        return None;
+    };
+    Some(functions)
+}
+fn take_facet(document: &mut Json, name: &str, limit: usize, why: Omission) -> Vec<RemovedFacet> {
+    let mut removed = Vec::new();
+    if let Some(functions) = function_records(document) {
+        for (function, record) in functions.iter_mut().enumerate() {
+            if let Json::Object(fields) = record {
+                if matches!(why, Omission::RedundantWithGraph)
+                    && !fields.iter().any(|(key, _)| key == "atomic_facts")
+                {
+                    continue;
+                }
+                if let Some(field) = fields.iter().position(|(key, _)| key == name) {
+                    let value = fields.remove(field);
+                    let error = format!("{name}_error");
+                    let added_error = matches!(why, Omission::Capacity)
+                        && !fields.iter().any(|(key, _)| key == &error);
+                    if added_error {
+                        fields.push((error, Json::Str(format!("atomic encoded document exceeds {limit} byte capacity; {name} omitted, code retained"))));
+                    }
+                    removed.push(RemovedFacet {
+                        function,
+                        field,
+                        value,
+                        added_error,
+                    });
+                }
+            }
+        }
+    }
+    removed
+}
+fn restore_facet(document: &mut Json, removed: Vec<RemovedFacet>) {
+    if let Some(functions) = function_records(document) {
+        for facet in removed {
+            if let Json::Object(fields) = &mut functions[facet.function] {
+                if facet.added_error {
+                    let error = format!("{}_error", facet.value.0);
+                    fields.retain(|(key, _)| key != &error);
+                }
+                fields.insert(facet.field, facet.value);
+            }
+        }
+    }
+}
+struct GraphAlternative {
+    function: usize,
+    value: Json,
+}
+fn compress_graphs(document: &mut Json, budget: usize) -> Vec<GraphAlternative> {
+    let mut originals = Vec::new();
+    let mut remaining = budget;
+    if let Some(functions) = function_records(document) {
+        for (function, record) in functions.iter_mut().enumerate() {
+            if let Json::Object(fields) = record {
+                if let Some((_, graph)) = fields.iter_mut().find(|(key, _)| key == "atomic_facts") {
+                    if let Some((encoded, size)) =
+                        crate::atomic_compression::encode(graph, remaining)
+                    {
+                        remaining -= size;
+                        originals.push(GraphAlternative {
+                            function,
+                            value: std::mem::replace(graph, encoded),
+                        });
+                    }
+                }
+            }
+        }
+    }
+    originals
+}
+fn exchange_graphs(
+    document: &mut Json,
+    alternatives: Vec<GraphAlternative>,
+) -> Vec<GraphAlternative> {
+    let mut previous = Vec::new();
+    if let Some(functions) = function_records(document) {
+        for alternative in alternatives {
+            if let Json::Object(fields) = &mut functions[alternative.function] {
+                if let Some((_, graph)) = fields.iter_mut().find(|(key, _)| key == "atomic_facts") {
+                    previous.push(GraphAlternative {
+                        function: alternative.function,
+                        value: std::mem::replace(graph, alternative.value),
+                    });
+                }
+            }
+        }
+    }
+    previous
+}
+fn bounded(document: &Json, budget: usize) -> Option<String> {
+    let mut text = dumps_compact_bounded(document, budget)?;
+    text.push('\n');
+    Some(text)
+}
+// Reclaim a saved independent facet when other omissions have made room.
+// Only bounded encoded strings coexist here, never cloned graph/facet trees.
+fn bounded_reclaiming(
+    document: &mut Json,
+    budget: usize,
+    name: &str,
+    saved: &mut Vec<RemovedFacet>,
+) -> Option<String> {
+    let base = bounded(document, budget)?;
+    if saved.is_empty() {
+        return Some(base);
+    }
+    restore_facet(document, std::mem::take(saved));
+    if let Some(complete) = bounded(document, budget) {
+        return Some(complete);
+    }
+    *saved = take_facet(document, name, budget + 1, Omission::Capacity);
+    Some(base)
+}
+pub(crate) fn render(mut document: Json, limit: usize) -> Result<String, String> {
+    let budget = limit
+        .checked_sub(1)
+        .ok_or("atomic JSON output budget is zero")?;
+    // A full graph already owns these operation/value facts. Keep its bounded
+    // projection aside in case encoded size later makes that graph unavailable.
+    let projection = take_facet(
+        &mut document,
+        "atomic_projection",
+        limit,
+        Omission::RedundantWithGraph,
+    );
+    if let Some(text) = bounded(&document, budget) {
+        return Ok(text);
+    }
+    let originals = compress_graphs(&mut document, budget);
+    let mut alternatives = if originals.is_empty() {
+        Vec::new()
+    } else {
+        if let Some(text) = bounded(&document, budget) {
+            return Ok(text);
+        }
+        exchange_graphs(&mut document, originals)
+    };
+    // New switch rows must not displace previously available graph/call facts.
+    // Retry without that independent facet before weakening existing coverage.
+    let mut switches = take_facet(&mut document, "atomic_switches", limit, Omission::Capacity);
+    if !switches.is_empty() {
+        if let Some(text) = bounded(&document, budget) {
+            return Ok(text);
+        }
+        if !alternatives.is_empty() {
+            let originals = exchange_graphs(&mut document, alternatives);
+            if let Some(text) = bounded(&document, budget) {
+                return Ok(text);
+            }
+            alternatives = exchange_graphs(&mut document, originals);
+        }
+    }
+    let calls = take_facet(&mut document, "atomic_calls", limit, Omission::Capacity);
+    if !calls.is_empty() {
+        if let Some(text) =
+            bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+        {
+            return Ok(text);
+        }
+        if !alternatives.is_empty() {
+            drop(exchange_graphs(&mut document, alternatives));
+            if let Some(text) =
+                bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+            {
+                return Ok(text);
+            }
+        }
+    }
+    restore_facet(&mut document, calls);
+    take_facet(&mut document, "atomic_facts", limit, Omission::Capacity);
+    restore_facet(&mut document, projection);
+    restore_facet(&mut document, std::mem::take(&mut switches));
+    if let Some(text) = bounded(&document, budget) {
+        return Ok(text);
+    }
+    switches = take_facet(&mut document, "atomic_switches", limit, Omission::Capacity);
+    if !switches.is_empty() {
+        if let Some(text) = bounded(&document, budget) {
+            return Ok(text);
+        }
+    }
+    // Independent calls retain priority when the combined fallback is too big.
+    let projection = take_facet(
+        &mut document,
+        "atomic_projection",
+        limit,
+        Omission::Capacity,
+    );
+    if let Some(text) = bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+    {
+        return Ok(text);
+    }
+    restore_facet(&mut document, projection);
+    take_facet(&mut document, "atomic_calls", limit, Omission::Capacity);
+    if let Some(text) = bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches)
+    {
+        return Ok(text);
+    }
+    take_facet(
+        &mut document,
+        "atomic_projection",
+        limit,
+        Omission::Capacity,
+    );
+    bounded_reclaiming(&mut document, budget, "atomic_switches", &mut switches).ok_or_else(|| {
+        format!("atomic JSON exceeds {limit} byte capacity even without recovered facets")
+    })
+}
+
+#[cfg(test)]
+mod switch_facet_tests {
+    use super::*;
+    fn document(graph: usize, calls: usize, projection: usize, switches: usize) -> Json {
+        Json::Object(vec![(
+            "functions".into(),
+            Json::Array(vec![Json::Object(vec![
+                ("code".into(), Json::Str("retained C".into())),
+                ("atomic_facts".into(), Json::Str("g".repeat(graph))),
+                ("atomic_calls".into(), Json::Str("c".repeat(calls))),
+                (
+                    "atomic_projection".into(),
+                    Json::Str("p".repeat(projection)),
+                ),
+                ("atomic_switches".into(), Json::Str("s".repeat(switches))),
+            ])]),
+        )])
+    }
+    #[test]
+    fn oversized_switches_do_not_displace_existing_graph_and_calls() {
+        let text = render(document(600, 20, 10, 5000), 1500).unwrap();
+        let d: serde_json::Value = serde_json::from_str(&text).unwrap();
+        let f = &d["functions"][0];
+        assert_eq!(f["code"], "retained C");
+        assert_eq!(f["atomic_facts"].as_str().unwrap().len(), 600);
+        assert_eq!(f["atomic_calls"].as_str().unwrap().len(), 20);
+        assert!(f.get("atomic_switches").is_none());
+        assert!(f["atomic_switches_error"].is_string());
+    }
+    #[test]
+    fn reclaim_switches_after_a_large_projection_is_omitted() {
+        let text = render(document(5000, 100, 3000, 100), 2000).unwrap();
+        let d: serde_json::Value = serde_json::from_str(&text).unwrap();
+        let f = &d["functions"][0];
+        assert_eq!(f["atomic_calls"].as_str().unwrap().len(), 100);
+        assert_eq!(f["atomic_switches"].as_str().unwrap().len(), 100);
+        assert!(f.get("atomic_projection").is_none());
+        assert!(f.get("atomic_switches_error").is_none());
+    }
+    #[test]
+    fn independent_switch_rows_survive_when_all_other_facets_overflow() {
+        let text = render(document(5000, 5000, 5000, 1200), 2000).unwrap();
+        let d: serde_json::Value = serde_json::from_str(&text).unwrap();
+        let f = &d["functions"][0];
+        assert_eq!(f["code"], "retained C");
+        assert_eq!(f["atomic_switches"].as_str().unwrap().len(), 1200);
+        assert!(f.get("atomic_switches_error").is_none());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn encoded_overflow_preserves_code_and_replaces_only_the_graph() {
+        let original = Json::Object(vec![(
+            "functions".into(),
+            Json::Array(vec![Json::Object(vec![
+                ("code".into(), Json::Str("retained C".into())),
+                ("error".into(), Json::Null),
+                ("atomic_facts".into(), Json::Str("😀".repeat(1000))),
+            ])]),
+        )]);
+        let full = render(original.clone(), 20000).unwrap();
+        assert!(full.len() > 12000); // ASCII surrogate escaping is accounted for.
+        let reduced = render(original.clone(), 256).unwrap();
+        let document: serde_json::Value = serde_json::from_str(&reduced).unwrap();
+        let function = &document["functions"][0];
+        assert_eq!(function["code"], "retained C");
+        assert_eq!(function["error"], serde_json::Value::Null);
+        assert!(function.get("atomic_facts").is_none());
+        assert!(function["atomic_facts_error"]
+            .as_str()
+            .unwrap()
+            .contains("256"));
+        assert!(reduced.len() <= 256);
+        assert!(render(original, 1).is_err());
+    }
+}
+
+#[cfg(test)]
+mod compressed_graph_tests {
+    use super::*;
+    use base64::{engine::general_purpose::STANDARD, Engine as _};
+    use std::io::Read;
+    #[test]
+    fn compressed_graph_retains_calls_and_code_before_losing_any_facet() {
+        let graph = Json::Object(vec![
+            ("schema_version".into(), Json::Number("3".into())),
+            ("payload".into(), Json::Str("x".repeat(100_000))),
+        ]);
+        let original = Json::Object(vec![(
+            "functions".into(),
+            Json::Array(vec![Json::Object(vec![
+                ("code".into(), Json::Str("retained C".into())),
+                ("atomic_facts".into(), graph.clone()),
+                ("atomic_calls".into(), Json::Str("independent calls".into())),
+                ("atomic_projection".into(), Json::Str("fallback".into())),
+            ])]),
+        )]);
+        let uncompressed: serde_json::Value =
+            serde_json::from_str(&render(original.clone(), 200_000).unwrap()).unwrap();
+        assert_eq!(
+            uncompressed["functions"][0]["atomic_facts"]["schema_version"],
+            3
+        );
+        let text = render(original.clone(), 4096).unwrap();
+        assert!(text.len() <= 4096);
+        let document: serde_json::Value = serde_json::from_str(&text).unwrap();
+        let function = &document["functions"][0];
+        assert_eq!(function["code"], "retained C");
+        assert_eq!(function["atomic_calls"], "independent calls");
+        assert!(function.get("atomic_projection").is_none());
+        assert!(function.get("atomic_facts_error").is_none());
+        let frame = &function["atomic_facts"];
+        assert_eq!(frame["schema_version"], 4);
+        let compressed = STANDARD.decode(frame["data"].as_str().unwrap()).unwrap();
+        let mut restored = String::new();
+        flate2::read::GzDecoder::new(compressed.as_slice())
+            .read_to_string(&mut restored)
+            .unwrap();
+        assert_eq!(restored, dumps_compact_bounded(&graph, 200_000).unwrap());
+        let tiny: serde_json::Value =
+            serde_json::from_str(&render(original, 512).unwrap()).unwrap();
+        assert!(tiny["functions"][0].get("atomic_facts").is_none());
+        assert_eq!(tiny["functions"][0]["atomic_projection"], "fallback");
+        assert_eq!(tiny["functions"][0]["atomic_calls"], "independent calls");
+    }
+}
+
+#[cfg(test)]
+mod independent_facet_tests {
+    use super::*;
+    fn document(graph: usize, calls: usize) -> Json {
+        Json::Object(vec![(
+            "functions".into(),
+            Json::Array(vec![Json::Object(vec![
+                ("code".into(), Json::Str("retained C".into())),
+                ("ordinary".into(), Json::Number("42".into())),
+                ("atomic_facts".into(), Json::Str("x".repeat(graph))),
+                ("atomic_calls".into(), Json::Str("y".repeat(calls))),
+            ])]),
+        )])
+    }
+    #[test]
+    fn each_facet_survives_the_others_encoded_overflow() {
+        for (graph, calls, keep) in [(2000, 1, "atomic_calls"), (1, 2000, "atomic_facts")] {
+            let rendered = render(document(graph, calls), 512).unwrap();
+            assert!(rendered.len() <= 512);
+            let d: serde_json::Value = serde_json::from_str(&rendered).unwrap();
+            let f = &d["functions"][0];
+            assert!(f.get(keep).is_some());
+            assert_eq!(f["ordinary"], 42);
+            assert_eq!(f["code"], "retained C");
+        }
+    }
+    #[test]
+    fn jointly_oversized_facets_preserve_the_existing_graph_when_it_fits() {
+        let rendered = render(document(1000, 1000), 1600).unwrap();
+        let d: serde_json::Value = serde_json::from_str(&rendered).unwrap();
+        assert!(d["functions"][0].get("atomic_facts").is_some());
+        assert!(d["functions"][0].get("atomic_calls").is_none());
+    }
+    #[test]
+    fn base_record_survives_both_overflows_or_fails_explicitly() {
+        let rendered = render(document(2000, 2000), 512).unwrap();
+        let d: serde_json::Value = serde_json::from_str(&rendered).unwrap();
+        let f = &d["functions"][0];
+        assert!(f.get("atomic_facts").is_none() && f.get("atomic_calls").is_none());
+        assert!(f["atomic_facts_error"].is_string() && f["atomic_calls_error"].is_string());
+        assert_eq!(f["code"], "retained C");
+        assert!(render(document(1, 1), 1).is_err());
+    }
+}
+
+#[cfg(test)]
+mod projection_tests {
+    use super::*;
+    fn document(graph: usize, calls: usize, projection: usize) -> Json {
+        Json::Object(vec![(
+            "functions".into(),
+            Json::Array(vec![Json::Object(vec![
+                ("code".into(), Json::Str("retained C".into())),
+                ("atomic_facts".into(), Json::Str("g".repeat(graph))),
+                ("atomic_calls".into(), Json::Str("c".repeat(calls))),
+                (
+                    "atomic_projection".into(),
+                    Json::Str("p".repeat(projection)),
+                ),
+            ])]),
+        )])
