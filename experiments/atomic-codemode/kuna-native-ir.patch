+// Named independent facets share serialization/failure semantics; a bad facet
+// cannot erase the ordinary C record or another valid facet.
+fn append_atomic_facet<T: serde::Serialize>(record: &mut Vec<(String, Json)>, name: &str, facts: Option<&Result<T, String>>) {
+    if let Some(facts) = facts {
+        let encoded = facts.as_ref().map_err(Clone::clone)
+            .and_then(|facts| serde_json::to_value(facts).map_err(|error| format!("atomic facet serialization failed: {error}")));
+        match encoded {
+            Ok(value) => record.push((name.into(), Json::from(value))),
+            Err(reason) => record.push((format!("{name}_error"), Json::Str(reason))),
+        }
+    }
+}
