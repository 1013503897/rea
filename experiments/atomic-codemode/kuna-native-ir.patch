+#[test]
+fn atomic_case_rows_keep_ordinals_labels_and_edges_separate() {
+    let manage = build_manager();
+    let ram = Rc::clone(manage.get_space_by_name("ram").unwrap());
+    let mut table = JumpTable::new(Address::new(Rc::clone(&ram), 0x1000));
+    table.kuna_push_entry(Address::new(Rc::clone(&ram), 0x3000), 2, 0x77);
+    table.kuna_push_entry(Address::new(Rc::clone(&ram), 0x4000), 0, NO_LABEL);
+    table.kuna_finalize(0);
+    let rows: Vec<_> = table.case_rows().unwrap()
+        .map(|(index, address, label)| (index, address.get_offset(), label)).collect();
+    assert_eq!(rows, vec![(0, 0x3000, Some(0x77)), (1, 0x4000, Some(NO_LABEL))]);
+    assert_eq!(table.case_edge_rows().collect::<Vec<_>>(), vec![(1, 0), (0, 2)]);
+    table.label.pop();
+    assert_eq!(table.case_rows().unwrap().nth(1).unwrap().2, None);
+    table.label.extend([1, 2]);
+    assert!(table.case_rows().is_err());
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_calls.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_calls.rs
new file mode 100644
index 00000000..fa04cafc
--- /dev/null
+++ b/decompiler/crates/kuna-decomp/src/substrate/atomic_calls.rs
@@ -0,0 +1,189 @@
+//! Recovered call relations. Argument values and passing storage are separate.
+use crate::{
+    atomic_membership::{Membership, MAX_CALLS},
+    atomic_values::{self, operation_id, value_id, ValueFact},
+    context::OpId,
+    atomic_storage::{location, storage, Location, Storage},
+    fspec::{FuncCallSpecs, OFFSET_UNKNOWN},
+    funcdata::Funcdata,
+};
+use serde::Serialize;
+use std::collections::{BTreeSet, HashMap};
+
+#[derive(Debug, Clone, Serialize)]
+pub struct CallFacts {
+    pub schema_version: u32,
+    pub items: Vec<CallFact>,
+    pub values: Vec<ValueFact>,
+    pub coverage: CallCoverage,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct CallCoverage {
+    pub scope: &'static str,
+    pub blocks_examined: i32,
+    pub operations_examined: usize,
+    pub value_scope: &'static str,
+    pub machine_call_equivalence: &'static str,
+}
+
+pub fn collect_all(fd: &Funcdata, membership: &Membership) -> Result<CallFacts, String> {
+    const MAX_VALUES: usize = 36_000;
+    const MAX_INPUTS: usize = 50_000;
+    if fd.bblocks_get_size() <= 0 {
+        return Err("recovered block membership is unavailable".into());
+    }
+    if fd.num_calls() < 0 || fd.num_calls() as usize > MAX_CALLS {
+        return Err("atomic call-spec capacity exceeded".into());
+    }
+    let mut specs = HashMap::new();
+    for i in 0..fd.num_calls() {
+        let spec = fd.get_call_specs(i);
+        if specs.insert(spec.get_op(), spec).is_some() {
+            return Err("duplicate native call-spec operation".into());
+        }
+    }
+    let mut items = Vec::new();
+    let mut keys = BTreeSet::new();
+    let mut inputs = 0usize;
+    let mut text = atomic_values::TextBudget::new(2 * 1024 * 1024);
+    for &key in &membership.calls {
+        let op = fd.obank().get(key).ok_or("stale call operation")?;
+        inputs = inputs
+            .checked_add(op.num_input() as usize)
+            .ok_or("atomic call input count overflow")?;
+        if inputs > MAX_INPUTS {
+            return Err("atomic call input capacity exceeded".into());
+        }
+        let spec = specs.get(&key).copied();
+        if let Some(spec) = spec {
+            text.charge(spec.get_name().len())?;
+            if spec.proto().has_model() {
+                text.charge(spec.proto().get_model_name().len())?;
+            }
+        }
+        for index in 0..op.num_input() {
+            if let Some(v) = op.get_in(index) {
+                keys.insert(v);
+            }
+        }
+        if let Some(v) = op.get_out() {
+            keys.insert(v);
+        }
+        if keys.len() > MAX_VALUES {
+            return Err("atomic call value capacity exceeded".into());
+        }
+        items.push(collect(fd, key, spec)?);
+    }
+    let values = atomic_values::collect(fd, keys, &mut text)?;
+    Ok(CallFacts {
+        schema_version: 1, items, values,
+        coverage: CallCoverage {
+            scope: "all recovered block-member CALL/CALLIND operations",
+            blocks_examined: membership.blocks_examined, operations_examined: membership.operations_examined,
+            value_scope: "call inputs including target and outputs only; definitions may be outside this facet",
+            machine_call_equivalence: "unknown",
+        },
+    })
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub struct Argument {
+    pub input_index: i32,
+    pub value_id: Option<String>,
+    pub storage: Option<Storage>,
+    pub storage_authority: Option<&'static str>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Prototype {
+    pub model: Option<String>,
+    pub model_unknown: Option<bool>,
+    pub inputs_locked: bool,
+    pub variadic: bool,
+    pub parameter_shift: i32,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct CallFact {
+    pub id: String,
+    pub origin_address: String,
+    pub block: i32,
+    pub opcode: String,
+    pub is_dead: bool,
+    pub target_value_id: Option<String>,
+    pub spec_available: bool,
+    pub target: Option<Location>,
+    pub target_name: Option<String>,
+    pub arguments: Vec<Argument>,
+    pub output: Option<String>,
+    pub prototype: Option<Prototype>,
+    pub stack_offset: Option<String>,
+}
+fn collect(fd: &Funcdata, key: OpId, spec: Option<&FuncCallSpecs>) -> Result<CallFact, String> {
+    let op = fd.obank().get(key).ok_or("stale call operation")?;
+    let arguments = (1..op.num_input())
+        .map(|input_index| {
+            // The native owner stores finalized passing locations separately
+            // from SSA values. Admit that mapping only with matching arity.
+            // Placeholder/shifted inputs are not source parameter ordinals.
+            let binding = spec.and_then(|spec| {
+                if spec.get_paramshift() != 0 || spec.get_stack_placeholder_slot() == input_index {
+                    return None;
+                }
+                if spec.final_input_storage().len() + 1 == op.num_input() as usize {
+                    let (address, size) = &spec.final_input_storage()[(input_index - 1) as usize];
+                    return storage(address, *size).map(|s| (s, "final-input-storage"));
+                }
+                let proto = spec.proto();
+                if proto.has_store() && proto.is_input_locked() {
+                    return proto.get_param(input_index - 1).and_then(|param| {
+                        storage(&param.get_address(), param.get_size())
+                            .map(|s| (s, "locked-prototype"))
+                    });
+                }
+                None
+            });
+            let (storage, storage_authority) = match binding {
+                Some((s, authority)) => (Some(s), Some(authority)),
+                None => (None, None),
+            };
+            Argument {
+                input_index,
+                value_id: op.get_in(input_index).map(value_id),
+                storage,
+                storage_authority,
+            }
+        })
+        .collect();
+    Ok(CallFact {
+        id: operation_id(fd, key)?,
+        origin_address: format!("0x{:x}", op.get_seq_num().get_addr().get_offset()),
+        block: fd
+            .bblocks_ref()
+            .block(op.get_parent().ok_or("call has no recovered block")?)
+            .get_index(),
+        opcode: format!("{:?}", op.code()),
+        is_dead: op.is_dead(),
+        target_value_id: op.get_in(0).map(value_id),
+        spec_available: spec.is_some(),
+        target: spec.and_then(|s| location(s.get_entry_address())),
+        target_name: spec
+            .and_then(|s| (!s.get_name().is_empty()).then(|| s.get_name().to_string())),
+        arguments,
+        output: op.get_out().map(value_id),
+        prototype: spec.map(|s| {
+            let proto = s.proto();
+            Prototype {
+                model: proto
+                    .has_model()
+                    .then(|| proto.get_model_name().to_string()),
+                model_unknown: proto.has_model().then(|| proto.is_model_unknown()),
+                inputs_locked: proto.is_input_locked(),
+                variadic: proto.is_dotdotdot(),
+                parameter_shift: s.get_paramshift(),
+            }
+        }),
+        stack_offset: spec.and_then(|s| {
+            (s.get_spacebase_offset() != OFFSET_UNKNOWN)
+                .then(|| format!("0x{:x}", s.get_spacebase_offset()))
+        }),
+    })
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_facts.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_facts.rs
new file mode 100644
index 00000000..6b9afe69
--- /dev/null
+++ b/decompiler/crates/kuna-decomp/src/substrate/atomic_facts.rs
@@ -0,0 +1,156 @@
+//! Opt-in, read-only export of the recovered function IR for the REA experiment.
+//! IDs are local to this captured model; addresses alone are not SSA identities.
+use crate::{
+    architecture::Architecture,
+    atomic_membership::Membership,
+    atomic_operations::{OperationBudget, OperationFact},
+    atomic_values::{operation_id, value_id, ValueFact},
+    funcdata::Funcdata,
+};
+use kuna_num::opcodes::OpCode;
+use serde::Serialize;
+use std::collections::BTreeSet;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct FunctionFacts {
+    pub schema_version: u32,
+    pub blocks: Vec<BlockFact>,
+    pub operations: Vec<OperationFact>,
+    pub values: Vec<ValueFact>,
+    pub coverage: Coverage,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Coverage {
+    pub scope: &'static str,
+    pub machine_semantic_equivalence: &'static str,
+    pub indirect_branch_operations: Vec<String>,
+    pub omitted_definition_ids: Vec<String>,
+    pub issues: Vec<String>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct BlockFact {
+    pub id: i32,
+    pub start: String,
+    pub operations: Vec<String>,
+    pub predecessors: Vec<i32>,
+    pub successors: Vec<EdgeFact>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct EdgeFact {
+    pub id: String,
+    pub target: i32,
+    pub index: i32,
+    pub polarity: Option<&'static str>,
+    pub condition_value: Option<String>,
+    pub condition_test: Option<&'static str>,
+}
+pub fn collect(
+    arch: &Architecture,
+    fd: &Funcdata,
+    membership: &Membership,
+) -> Result<FunctionFacts, String> {
+    // Bounds cover allocations before JSON serialization, independently of the
+    // transport byte budget. Overflow is an unavailable facet, not clipped IR.
+    const MAX_OPERATIONS: usize = 32_000;
+    const MAX_VALUES: usize = 36_000;
+    const MAX_INPUTS: usize = 100_000;
+    const MAX_DISPLAY_BYTES: usize = 4 * 1024 * 1024;
+    const MAX_CFG_EDGES: usize = 50_000;
+    if fd.bblocks_get_size() <= 0 {
+        return Err("recovered basic-block graph is unavailable".into());
+    }
+    if fd.bblocks_get_size() > 12_000 {
+        return Err("atomic block capacity exceeded".into());
+    }
+    if membership.operations_examined > MAX_OPERATIONS {
+        return Err("atomic operation capacity exceeded".into());
+    }
+    let mut blocks = Vec::new();
+    let mut operations = Vec::new();
+    let mut retained_ops = BTreeSet::new();
+    let mut edge_count = 0usize;
+    let mut budget = OperationBudget::new(MAX_VALUES, MAX_INPUTS, MAX_DISPLAY_BYTES);
+    let mut coverage = Coverage {
+        scope: "complete native recovered basic-block graph; block-member operations",
+        machine_semantic_equivalence: "unknown",
+        indirect_branch_operations: Vec::new(),
+        omitted_definition_ids: Vec::new(),
+        issues: Vec::new(),
+    };
+    for block_index in 0..fd.bblocks_get_size() {
+        let block_key = fd.bblocks_get_block(block_index);
+        let block = fd.bblocks_ref().block(block_key);
+        let members = fd.bb_ops(block_key);
+        if members.len() > MAX_OPERATIONS - operations.len() {
+            return Err("atomic operation capacity exceeded".into());
+        }
+        edge_count = edge_count
+            .checked_add(block.size_out() as usize)
+            .ok_or("atomic CFG edge count overflow")?;
+        if edge_count > MAX_CFG_EDGES {
+            return Err("atomic CFG edge capacity exceeded".into());
+        }
+        let tail = members.last().and_then(|id| fd.obank().get(*id));
+        let conditional =
+            tail.filter(|op| op.code() == OpCode::CPUI_CBRANCH && block.size_out() == 2);
+        let condition_value = conditional.and_then(|op| op.get_in(1)).map(value_id);
+        let condition_test = conditional.map(|op| {
+            if op.is_boolean_flip() {
+                "eq-zero"
+            } else {
+                "ne-zero"
+            }
+        });
+        let successors = (0..block.size_out())
+            .map(|i| EdgeFact {
+                id: format!("{}:{i}", block.get_index()),
+                target: fd.bblocks_ref().block(block.get_out(i)).get_index(),
+                index: i,
+                polarity: conditional.map(|_| if i == 0 { "false" } else { "true" }),
+                condition_value: condition_value.clone(),
+                condition_test,
+            })
+            .collect();
+        blocks.push(BlockFact {
+            id: block.get_index(),
+            start: format!("0x{:x}", fd.bblocks_block_start(block_key).get_offset()),
+            operations: members
+                .iter()
+                .map(|id| operation_id(fd, *id))
+                .collect::<Result<_, _>>()?,
+            predecessors: (0..block.size_in())
+                .map(|i| fd.bblocks_ref().block(block.get_in(i)).get_index())
+                .collect(),
+            successors,
+        });
+        for key in members {
+            if operations.len() >= MAX_OPERATIONS {
+                return Err("atomic operation capacity exceeded".into());
+            }
+            let op = budget.collect(arch, fd, key)?;
+            if !retained_ops.insert(op.id.clone()) {
+                return Err("operation belongs to multiple recovered blocks".into());
+            }
+            if op.opcode == "CPUI_BRANCHIND" {
+                coverage.indirect_branch_operations.push(op.id.clone());
+            }
+            operations.push(op);
+        }
+    }
+    let values = budget.values(fd)?;
+    coverage.issues = budget.issues;
+    let missing: BTreeSet<_> = values
+        .iter()
+        .filter_map(|v| v.definition.as_ref())
+        .filter(|id| !retained_ops.contains(*id))
+        .cloned()
+        .collect();
+    coverage.omitted_definition_ids = missing.into_iter().collect();
+    Ok(FunctionFacts {
+        schema_version: 3,
+        blocks,
+        operations,
+        values,
+        coverage,
+    })
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_membership.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_membership.rs
new file mode 100644
index 00000000..be11e472
--- /dev/null
+++ b/decompiler/crates/kuna-decomp/src/substrate/atomic_membership.rs
@@ -0,0 +1,76 @@
+//! One validated membership scan for independent recovered fact facets.
+use crate::{context::OpId, funcdata::Funcdata};
+use kuna_num::opcodes::OpCode;
+use std::collections::HashSet;
+
+pub const MAX_CALLS: usize = 12_000;
+const MAX_SWITCHES: usize = 12_000;
+// Bound the optional membership index separately from call discovery. Crossing
+// this resource budget disables projections, without discarding known calls.
+const MAX_INDEXED_OPERATIONS: usize = 65_536;
+pub struct Membership {
+    pub calls: Vec<OpId>,
+    pub switches: Option<Vec<OpId>>,
+    pub members: Option<HashSet<OpId>>,
+    pub blocks_examined: i32,
+    pub operations_examined: usize,
+}
+pub fn inspect(fd: &Funcdata) -> Result<Membership, String> {
+    if fd.bblocks_get_size() <= 0 {
+        return Err("recovered block membership is unavailable".into());
+    }
+    let mut result = Membership {
+        calls: Vec::new(),
+        switches: Some(Vec::new()),
+        members: Some(HashSet::new()),
+        blocks_examined: fd.bblocks_get_size(),
+        operations_examined: 0,
+    };
+    for i in 0..fd.bblocks_get_size() {
+        let block = fd.bblocks_get_block(i);
+        let expected = fd.bb_op_len(block);
+        let mut examined = 0;
+        let mut cursor = fd.bb_op_head(block);
+        while let Some(key) = cursor {
+            if examined >= expected {
+                return Err("cyclic native block operation list".into());
+            }
+            examined += 1;
+            result.operations_examined = result
+                .operations_examined
+                .checked_add(1)
+                .ok_or("native operation count overflow")?;
+            let op = fd.obank().get(key).ok_or("stale block operation")?;
+            if op.get_parent() != Some(block) {
+                return Err("native block ownership mismatch".into());
+            }
+            cursor = op.basic_neighbours().1;
+            if let Some(members) = result.members.as_mut() {
+                if members.len() == MAX_INDEXED_OPERATIONS {
+                    result.members = None;
+                } else if !members.insert(key) {
+                    return Err("operation belongs to multiple recovered blocks".into());
+                }
+            }
+            if matches!(op.code(), OpCode::CPUI_CALL | OpCode::CPUI_CALLIND) {
+                if result.calls.len() >= MAX_CALLS {
+                    return Err("atomic call capacity exceeded".into());
+                }
+                result.calls.push(key);
+            }
+            if op.code() == OpCode::CPUI_BRANCHIND {
+                if let Some(switches) = result.switches.as_mut() {
+                    if switches.len() == MAX_SWITCHES {
+                        result.switches = None;
+                    } else {
+                        switches.push(key);
+                    }
+                }
+            }
+        }
+        if examined != expected {
+            return Err("native block operation count mismatch".into());
+        }
+    }
+    Ok(result)
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_operations.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_operations.rs
new file mode 100644
index 00000000..30d6be39
--- /dev/null
+++ b/decompiler/crates/kuna-decomp/src/substrate/atomic_operations.rs
@@ -0,0 +1,119 @@
+//! Shared read-only operation/value normalization for full and selected facts.
+use crate::{
+    architecture::Architecture,
+    atomic_values::{self, operation_id, value_id, ValueFact},
+    context::{OpId, VarnodeId},
+    funcdata::Funcdata,
+};
+use kuna_num::opcodes::OpCode;
+use serde::Serialize;
+use std::collections::BTreeSet;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct OperationFact {
+    pub id: String,
+    pub address: String,
+    pub block: i32,
+    pub opcode: String,
+    pub statement: String,
+    pub is_dead: bool,
+    pub inputs: Vec<InputFact>,
+    pub output: Option<String>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct InputFact {
+    pub input_index: i32,
+    pub value_id: Option<String>,
+    pub phi_predecessor: Option<i32>,
+    pub phi_predecessor_edge: Option<String>,
+}
+pub struct OperationBudget {
+    max_values: usize,
+    max_inputs: usize,
+    keys: BTreeSet<VarnodeId>,
+    input_count: usize,
+    text: atomic_values::TextBudget,
+    pub issues: Vec<String>,
+}
+impl OperationBudget {
+    pub fn new(max_values: usize, max_inputs: usize, max_display: usize) -> Self {
+        Self {
+            max_values,
+            max_inputs,
+            keys: BTreeSet::new(),
+            input_count: 0,
+            text: atomic_values::TextBudget::new(max_display),
+            issues: Vec::new(),
+        }
+    }
+    pub fn collect(
+        &mut self,
+        arch: &Architecture,
+        fd: &Funcdata,
+        key: OpId,
+    ) -> Result<OperationFact, String> {
+        let op = fd.obank().get(key).ok_or("stale operation")?;
+        let parent = op.get_parent().ok_or("operation has no recovered block")?;
+        let block = fd.bblocks_ref().block(parent);
+        let id = operation_id(fd, key)?;
+        if op.num_input() < 0 {
+            return Err("negative native input count".into());
+        }
+        self.input_count = self
+            .input_count
+            .checked_add(op.num_input() as usize)
+            .ok_or("atomic input count overflow")?;
+        if self.input_count > self.max_inputs {
+            return Err("atomic input-edge capacity exceeded".into());
+        }
+        let phi = op.code() == OpCode::CPUI_MULTIEQUAL;
+        let phi_bound = phi && block.size_in() == op.num_input();
+        if phi && !phi_bound {
+            self.issues
+                .push(format!("{id}: phi/predecessor count mismatch"));
+        }
+        let inputs = (0..op.num_input())
+            .map(|index| {
+                let value = op.get_in(index);
+                if let Some(v) = value {
+                    self.keys.insert(v);
+                }
+                InputFact {
+                    input_index: index,
+                    value_id: value.map(value_id),
+                    phi_predecessor: phi_bound
+                        .then(|| fd.bblocks_ref().block(block.get_in(index)).get_index()),
+                    phi_predecessor_edge: phi_bound.then(|| {
+                        format!(
+                            "{}:{}",
+                            fd.bblocks_ref().block(block.get_in(index)).get_index(),
+                            block.get_in_rev_index(index)
+                        )
+                    }),
+                }
+            })
+            .collect();
+        if let Some(v) = op.get_out() {
+            self.keys.insert(v);
+        }
+        if self.keys.len() > self.max_values {
+            return Err("atomic value capacity exceeded".into());
+        }
+        let mut statement = String::new();
+        crate::funcdata_printraw::render_op(&mut statement, arch, fd, key)?;
+        self.text.charge(statement.len())?;
+        Ok(OperationFact {
+            id,
+            address: format!("0x{:x}", op.get_seq_num().get_addr().get_offset()),
+            block: block.get_index(),
+            opcode: format!("{:?}", op.code()),
+            statement,
+            is_dead: op.is_dead(),
+            inputs,
+            output: op.get_out().map(value_id),
+        })
+    }
+    pub fn values(&mut self, fd: &Funcdata) -> Result<Vec<ValueFact>, String> {
+        atomic_values::collect(fd, std::mem::take(&mut self.keys), &mut self.text)
+    }
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_parameters.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_parameters.rs
new file mode 100644
index 00000000..82a34a49
--- /dev/null
+++ b/decompiler/crates/kuna-decomp/src/substrate/atomic_parameters.rs
@@ -0,0 +1,155 @@
+//! Native function prototype facts, independent of raw input varnodes/call count.
+use crate::{
+    atomic_storage::{storage, Storage},
+    atomic_values::TextBudget,
+    dtype::type_metatype,
+    fspec::{FuncProto, ProtoParameter},
+};
+use serde::Serialize;
+
+// Bound row expansion independently of the encoded document/text budgets.
+pub const MAX_PARAMETERS: usize = 12_000;
+#[derive(Debug, Clone, Serialize)]
+pub struct Parameter {
+    pub id: String,
+    pub native_index: Option<i32>,
+    pub name: String,
+    pub type_name: Option<String>,
+    pub size_bytes: i32,
+    pub is_void: Option<bool>,
+    pub storage: Option<Storage>,
+    pub type_locked: bool,
+    pub name_locked: bool,
+    pub size_locked: bool,
+    pub this_pointer: bool,
+    pub indirect_storage: bool,
+    pub hidden_return: bool,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Parameters {
+    pub schema_version: u32,
+    pub model: Option<String>,
+    pub model_unknown: Option<bool>,
+    pub inputs_locked: bool,
+    pub output_locked: bool,
+    pub variadic: bool,
+    pub input_errors: bool,
+    pub output_errors: bool,
+    pub items: Vec<Parameter>,
+    pub output: Parameter,
+}
+fn parameter(
+    p: &dyn ProtoParameter,
+    index: Option<i32>,
+    text: &mut TextBudget,
+) -> Result<Parameter, String> {
+    text.charge(p.get_name().len())?;
+    if let Some(t) = p.get_type() {
+        text.charge(t.get_name().len())?;
+    }
+    Ok(Parameter {
+        id: index.map_or_else(|| "return".into(), |i| format!("parameter:{i}")),
+        native_index: index,
+        name: p.get_name().into(),
+        type_name: p.get_type().map(|t| t.get_name().into()),
+        size_bytes: p.get_size(),
+        is_void: p
+            .get_type()
+            .map(|t| t.get_metatype() == type_metatype::TYPE_VOID),
+        storage: storage(&p.get_address(), p.get_size()),
+        type_locked: p.is_type_locked(),
+        name_locked: p.is_name_locked(),
+        size_locked: p.is_size_type_locked(),
+        this_pointer: p.is_this_pointer(),
+        indirect_storage: p.is_indirect_storage(),
+        hidden_return: p.is_hidden_return(),
+    })
+}
+pub fn collect(proto: &FuncProto) -> Result<Parameters, String> {
+    if !proto.has_store() {
+        return Err("native function prototype store is unavailable".into());
+    }
+    let count =
+        usize::try_from(proto.num_params()).map_err(|_| "invalid native parameter count")?;
+    if count > MAX_PARAMETERS {
+        return Err("atomic parameter row capacity exceeded".into());
+    }
+    let mut text = TextBudget::new(2 * 1024 * 1024);
+    if proto.has_model() {
+        text.charge(proto.get_model_name().len())?;
+    }
+    let mut items = Vec::with_capacity(count);
+    for i in 0..count {
+        let p = proto
+            .get_param(i as i32)
+            .ok_or("missing native parameter slot")?;
+        items.push(parameter(p, Some(i as i32), &mut text)?);
+    }
+    Ok(Parameters {
+        schema_version: 1,
+        model: proto.has_model().then(|| proto.get_model_name().into()),
+        model_unknown: proto.has_model().then(|| proto.is_model_unknown()),
+        inputs_locked: proto.is_input_locked(),
+        output_locked: proto.is_output_locked(),
+        variadic: proto.is_dotdotdot(),
+        input_errors: proto.has_input_errors(),
+        output_errors: proto.has_output_errors(),
+        items,
+        output: parameter(proto.get_output(), None, &mut text)?,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{dtype::Datatype, fspec::ParameterPieces};
+    use kuna_base::{
+        address::Address,
+        space::{spacetype, AddrSpace},
+    };
+    use std::rc::Rc;
+    #[test]
+    fn absent_store_is_unknown_not_an_empty_signature() {
+        assert!(collect(&FuncProto::new())
+            .unwrap_err()
+            .contains("unavailable"));
+    }
+    #[test]
+    fn native_slots_return_storage_void_and_locks_remain_distinct() {
+        let mut proto = FuncProto::new();
+        proto.attach_internal_store(Rc::new(Datatype::new(0, type_metatype::TYPE_VOID)));
+        let empty = collect(&proto).unwrap();
+        assert!(empty.items.is_empty());
+        assert_eq!(empty.output.is_void, Some(true));
+        assert!(empty.output.storage.is_none());
+        let reg = Rc::new(AddrSpace::new(
+            spacetype::IPTR_PROCESSOR,
+            "register",
+            false,
+            8,
+            1,
+            3,
+            0,
+            0,
+            0,
+        ));
+        let pieces = ParameterPieces {
+            addr: Address::new(reg, 0x38),
+            type_: Some(Rc::new(Datatype::new(8, type_metatype::TYPE_UNKNOWN))),
+            flags: 0,
+        };
+        proto.set_param(0, "display name", &pieces);
+        proto.set_input_lock(true);
+        proto.set_output(&pieces);
+        let facts = collect(&proto).unwrap();
+        assert_eq!(facts.items.len(), 1);
+        assert_eq!(facts.items[0].id, "parameter:0");
+        assert_eq!(facts.items[0].native_index, Some(0));
+        assert!(facts.inputs_locked && facts.items[0].type_locked);
+        assert_eq!(facts.output.is_void, Some(false));
+        let storage = facts.output.storage.unwrap();
+        assert_eq!(storage.location.space, "register");
+        assert_eq!(storage.location.offset, "0x38");
+        assert_eq!(storage.size_bytes, 8);
+    }
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_projection.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_projection.rs
new file mode 100644
index 00000000..097b153a
--- /dev/null
+++ b/decompiler/crates/kuna-decomp/src/substrate/atomic_projection.rs
@@ -0,0 +1,117 @@
+//! Bounded backward SSA facts, independent of full CFG export availability.
+use crate::{
+    architecture::Architecture,
+    atomic_membership::Membership,
+    atomic_operations::{OperationBudget, OperationFact},
+    atomic_values::{operation_id, ValueFact},
+    funcdata::Funcdata,
+};
+use serde::Serialize;
+use std::collections::{BTreeMap, HashSet, VecDeque};
+
+#[derive(Debug, Clone, Serialize)]
+pub struct Projection {
+    pub schema_version: u32,
+    pub roots: Vec<String>,
+    pub operations: Vec<OperationFact>,
+    pub values: Vec<ValueFact>,
+    pub coverage: Coverage,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Frontier {
+    pub definition: String,
+    pub reason: &'static str,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Coverage {
+    pub scope: &'static str,
+    pub operation_budget: usize,
+    pub frontier: Vec<Frontier>,
+    pub issues: Vec<String>,
+    pub machine_semantic_equivalence: &'static str,
+}
+pub fn collect(
+    arch: &Architecture,
+    fd: &Funcdata,
+    membership: &Membership,
+) -> Result<Projection, String> {
+    const MAX_OPERATIONS: usize = 4096;
+    let members = membership
+        .members
+        .as_ref()
+        .ok_or("projection membership-index capacity exceeded")?;
+    if membership.calls.len() > MAX_OPERATIONS {
+        return Err("projection call-root capacity exceeded".into());
+    }
+    let roots = membership
+        .calls
+        .iter()
+        .map(|key| operation_id(fd, *key))
+        .collect::<Result<Vec<_>, _>>()?;
+    let mut queue: VecDeque<_> = membership.calls.iter().copied().collect();
+    let mut queued: HashSet<_> = membership.calls.iter().copied().collect();
+    let mut retained = HashSet::new();
+    let mut operations = Vec::new();
+    let mut budget = OperationBudget::new(12_288, 16_384, 2 * 1024 * 1024);
+    while let Some(key) = queue.pop_front() {
+        if !members.contains(&key) {
+            continue;
+        }
+        if retained.len() == MAX_OPERATIONS {
+            break;
+        }
+        if !retained.insert(key) {
+            continue;
+        }
+        operations.push(budget.collect(arch, fd, key)?);
+        let op = fd.obank().get(key).ok_or("stale projection operation")?;
+        for i in 0..op.num_input() {
+            if let Some(value) = op.get_in(i) {
+                let value = fd.vbank().get(value).ok_or("stale projection operand")?;
+                if let Some(definition) = value.get_def() {
+                    if queued.insert(definition) {
+                        queue.push_back(definition);
+                    }
+                }
+            }
+        }
+    }
+    let values = budget.values(fd)?;
+    let retained_ids: HashSet<_> = operations.iter().map(|op| op.id.as_str()).collect();
+    let mut reasons = BTreeMap::new();
+    for key in queued.difference(&retained) {
+        reasons.insert(
+            operation_id(fd, *key)?,
+            if members.contains(key) {
+                "operation-budget"
+            } else {
+                "outside-recovered-membership"
+            },
+        );
+    }
+    let missing: HashSet<_> = values
+        .iter()
+        .filter_map(|v| v.definition.as_ref())
+        .filter(|id| !retained_ids.contains(id.as_str()))
+        .cloned()
+        .collect();
+    let frontier = reasons
+        .into_iter()
+        .filter(|(id, _)| missing.contains(id))
+        .map(|(definition, reason)| Frontier { definition, reason })
+        .collect();
+    Ok(Projection {
+        schema_version: 1,
+        roots,
+        operations,
+        values,
+        coverage: Coverage {
+            scope:
+                "call-rooted bounded backward SSA definitions; not a CFG or complete use inventory",
+            operation_budget: MAX_OPERATIONS,
+            frontier,
+            issues: budget.issues,
+            machine_semantic_equivalence: "unknown",
+        },
+    })
+}
