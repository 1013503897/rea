+#[test]
+fn bounded_writer_counts_actual_escaped_bytes_at_every_boundary() {
+    let value = Json::Object(vec![("escaped".into(), Json::Str("\0\"\\é😀".into()))]);
+    let complete = dumps_compact(&value);
+    assert!(complete.is_ascii());
+    for limit in 0..complete.len() {
+        assert!(dumps_compact_bounded(&value, limit).is_none());
+    }
+    assert_eq!(
+        dumps_compact_bounded(&value, complete.len()),
+        Some(complete.clone())
+    );
+    assert_eq!(
+        dumps_compact_bounded(&value, complete.len() + 1),
+        Some(complete)
+    );
+}
