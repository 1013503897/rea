+        for pac in [false, true] {
+            let mut entry = vec![BTI_C];
+            entry.extend_from_slice(&BODY[..3]);
+            if pac {
+                entry.push(AUTIA1716);
+            }
+            entry.push(BODY[3]);
+            let data = words(&entry);
+            for len in 0..data.len() {
+                assert!(
+                    names(0xbad0, &data[..len]).is_empty(),
+                    "truncated at {len}, PAC={pac}"
+                );
+            }
+        }
+        for (index, word) in [
+            (0, BODY[0] ^ 1),         // wrong page register
+            (1, BODY[1] ^ 1),         // wrong load register
+            (1, BODY[1] ^ (1 << 30)), // 32-bit load
+            (2, 0xd503201f),          // no ADD
+            (2, BODY[2] ^ (1 << 10)), // inconsistent GOT modifier
+            (2, BODY[2] | (1 << 22)), // ADD's shifted immediate
+            (3, 0xd63f0220),          // BLR is a call, not the veneer transfer
+            (3, 0xd61f0200),          // BR x16 is not the loaded x17
+        ] {
+            let mut body = BODY;
+            body[index] = word;
+            assert!(
+                names(0xbad4, &words(&body)).is_empty(),
+                "corrupt index {index}"
+            );
+        }
+        let mut body = BODY[..3].to_vec();
+        body.extend([0xd503219e, BODY[3]]); // not AUTIA1716
+        assert!(names(0xbad4, &words(&body)).is_empty());
+    }
+
+    #[test]
+    fn adjacent_entries_use_adrp_pc_and_exact_slots_without_stride_assumptions() {
+        // First ADRP sits on the next page after its BTI, with a negative page
+        // delta. The second plain entry is adjacent: no fixed 16/24-byte stride.
+        let first = [BTI_C, 0xf0fffff0, 0xf947fe11, 0x913fe210, 0xd61f0220];
+        let second = [0xf0fffff0, 0xf947fa11, 0x913fc210, 0xd61f0220];
+        let mut data = words(&first);
+        data.extend(words(&second));
+        let map = HashMap::from([(0x30ff8, b"one".to_vec()), (0x30ff0, b"two".to_vec())]);
+        let mut out = Vec::new();
+        let mut named = HashSet::new();
+        decode(0x30ffc, &data, &map, &mut out, &mut named);
+        assert_eq!(
+            out.iter()
+                .map(|s| (s.addr, s.name.as_slice()))
+                .collect::<Vec<_>>(),
+            [(0x30ffc, b"one".as_slice()), (0x31010, b"two".as_slice())]
+        );
+        decode(0x30ffc, &data, &map, &mut out, &mut named);
+        assert_eq!(out.len(), 2, "shared GOT deduplication remains intact");
+    }
+
+    #[test]
+    fn absent_slot_misalignment_and_overflow_cannot_create_entries() {
+        let data = words(&BODY);
+        assert!(names(0xbad5, &data).is_empty());
+        assert!(names(0xbbad4, &data).is_empty());
+        let mut out = Vec::new();
+        let map = HashMap::from([(0x104390, b"wrapped".to_vec())]);
+        decode(
+            0xbad4,
+            &data,
+            &HashMap::new(),
+            &mut out,
+            &mut HashSet::new(),
+        );
+        assert!(out.is_empty());
+        let mut overflow = words(&[BTI_C, BTI_C]);
+        overflow.extend_from_slice(&data);
+        decode(u64::MAX - 3, &overflow, &map, &mut out, &mut HashSet::new());
+        assert!(out.is_empty());
+    }
+}
