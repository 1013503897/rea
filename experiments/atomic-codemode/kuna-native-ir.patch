+        assert_eq!(advance(&mut pp, &s, 0x25750, &ops), vec![(0xb0468, kind)]);
+        // LOAD content stays unknown even when its address was proven.
+        assert!(advance(&mut pp, &s, 0x25754, &page_add(&s, 0x4040, 0x4040, 8)).is_empty());
