@@ -0,0 +1,198 @@
+//! Read-only native jump-table facts; row ordinals are not case values.
+use crate::{
+    atomic_membership::Membership,
+    atomic_values::{self, operation_id, ValueFact},
+    funcdata::Funcdata,
+    jumptable::NO_LABEL,
+};
+use kuna_base::address::Address;
+use serde::Serialize;
+use std::collections::{BTreeMap, BTreeSet};
+
+const MAX_ROWS: usize = 100_000;
+const MAX_MAPPINGS: usize = 100_000;
+#[derive(Debug, Clone, Serialize)]
+pub struct SwitchFacts {
+    pub schema_version: u32,
+    pub items: Vec<SwitchFact>,
+    pub coverage: Coverage,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Coverage {
+    pub scope: &'static str,
+    pub blocks_examined: i32,
+    pub operations_examined: usize,
+    pub machine_semantic_equivalence: &'static str,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct SwitchFact {
+    pub id: String,
+    pub origin_address: String,
+    pub block: i32,
+    pub selector: Option<ValueFact>,
+    pub table: Option<Table>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Table {
+    pub partial: bool,
+    pub labelled: bool,
+    pub consumed_mask: String,
+    pub signed_render_hint: bool,
+    pub default_raw_index: i32,
+    pub default_edge: Option<Edge>,
+    pub default_is_folded: bool,
+    pub rows: Vec<Row>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Edge {
+    pub id: String,
+    pub index: i32,
+    pub target: i32,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Row {
+    pub index: usize,
+    pub label: Option<Label>,
+    pub recovered_target: Option<Location>,
+    pub edges: Vec<Edge>,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Label {
+    pub status: &'static str,
+    pub raw_bits: String,
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct Location {
+    pub space: String,
+    pub offset: String,
+}
+fn location(
+    address: &Address,
+    text: &mut atomic_values::TextBudget,
+) -> Result<Option<Location>, String> {
+    let Some(space) = address.get_space() else {
+        return Ok(None);
+    };
+    text.charge(space.get_name().len())?;
+    Ok(Some(Location {
+        space: space.get_name().to_string(),
+        offset: format!("0x{:x}", address.get_offset()),
+    }))
+}
+fn edge(fd: &Funcdata, parent: crate::context::BlockId, index: i32) -> Result<Edge, String> {
+    let block = fd.bblocks_ref().block(parent);
+    if index < 0 || index >= block.size_out() {
+        return Err("native switch out-edge index is outside its block".into());
+    }
+    Ok(Edge {
+        id: format!("{}:{index}", block.get_index()),
+        index,
+        target: fd.bblocks_ref().block(block.get_out(index)).get_index(),
+    })
+}
+pub fn collect(fd: &Funcdata, membership: &Membership) -> Result<SwitchFacts, String> {
+    let switches = membership
+        .switches
+        .as_ref()
+        .ok_or("atomic switch capacity exceeded")?;
+    let mut items = Vec::with_capacity(switches.len());
+    let mut row_count = 0usize;
+    let mut mapping_count = 0usize;
+    let mut text = atomic_values::TextBudget::new(2 * 1024 * 1024);
+    for &key in switches {
+        let op = fd.obank().get(key).ok_or("stale switch operation")?;
+        let parent = op.get_parent().ok_or("native switch has no block")?;
+        let mut values = BTreeSet::new();
+        if let Some(value) = op.get_in(0) {
+            values.insert(value);
+        }
+        let selector = atomic_values::collect(fd, values, &mut text)?.pop();
+        if let Some(space) = selector.as_ref().and_then(|value| value.space.as_ref()) {
+            text.charge(space.len())?;
+        }
+        let table = if let Some(table) = fd.find_jump_table(key) {
+            if table.get_indirect_op() != Some(key) {
+                return Err("native jump-table operation identity is unresolved".into());
+            }
+            let observed = table.case_rows().map_err(|e| e.to_string())?;
+            row_count = row_count
+                .checked_add(observed.len())
+                .ok_or("atomic case count overflow")?;
+            let mappings = table.case_edge_rows();
+            mapping_count = mapping_count
+                .checked_add(mappings.len())
+                .ok_or("atomic case edge count overflow")?;
+            if row_count > MAX_ROWS || mapping_count > MAX_MAPPINGS {
+                return Err("atomic switch row/mapping capacity exceeded".into());
+            }
+            let mut by_row: BTreeMap<usize, Vec<Edge>> = BTreeMap::new();
+            let mut seen = BTreeSet::new();
+            for (row, position) in mappings {
+                if row < 0 || row as usize >= observed.len() {
+                    return Err("native switch mapping names an absent address row".into());
+                }
+                if !seen.insert((row, position)) {
+                    return Err("duplicate native switch row/out-edge mapping".into());
+                }
+                by_row
+                    .entry(row as usize)
+                    .or_default()
+                    .push(edge(fd, parent, position)?);
+            }
+            let rows = observed
+                .map(|(index, address, label)| {
+                    Ok(Row {
+                        index,
+                        label: label.map(|bits| Label {
+                            status: if bits == NO_LABEL {
+                                "no-label"
+                            } else {
+                                "value"
+                            },
+                            raw_bits: format!("0x{bits:x}"),
+                        }),
+                        recovered_target: location(address, &mut text)?,
+                        edges: by_row.remove(&index).unwrap_or_default(),
+                    })
+                })
+                .collect::<Result<Vec<_>, String>>()?;
+            let raw_default = table.get_default_block();
+            if raw_default < -1 {
+                return Err("invalid native default out-edge index".into());
+            }
+            Some(Table {
+                partial: table.is_partial(),
+                labelled: table.is_labelled(),
+                consumed_mask: format!("0x{:x}", table.get_switch_var_consume()),
+                signed_render_hint: table.kuna_has_signed_labels(),
+                default_raw_index: raw_default,
+                default_edge: if raw_default == -1 {
+                    None
+                } else {
+                    Some(edge(fd, parent, raw_default)?)
+                },
+                default_is_folded: table.has_folded_default(),
+                rows,
+            })
+        } else {
+            None
+        };
+        items.push(SwitchFact {
+            id: operation_id(fd, key)?,
+            origin_address: format!("0x{:x}", op.get_addr().get_offset()),
+            block: fd.bblocks_ref().block(parent).get_index(),
+            selector,
+            table,
+        });
+    }
+    Ok(SwitchFacts {
+        schema_version: 1,
+        items,
+        coverage: Coverage {
+            scope: "all recovered block-member BRANCHIND operations and native jump-table rows",
+            blocks_examined: membership.blocks_examined,
+            operations_examined: membership.operations_examined,
+            machine_semantic_equivalence: "unknown",
+        },
+    })
+}
diff --git a/decompiler/crates/kuna-decomp/src/substrate/atomic_values.rs b/decompiler/crates/kuna-decomp/src/substrate/atomic_values.rs
