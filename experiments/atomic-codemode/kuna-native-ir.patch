+        op(
+            OpCode::CPUI_INT_ADD,
+            Some(vn(&s.uniq, 0x10900, 4)),
+            vec![vn(&s.uniq, 0x2f00, 4), vn(&s.reg, 0x24, 4)],
+        ),
+        op(
+            OpCode::CPUI_LOAD,
+            Some(vn(&s.reg, 0x24, 4)),
+            vec![vn(&s.konst, ram_id(&s), 8), vn(&s.uniq, 0x10900, 4)],
+        ),
+    ];
