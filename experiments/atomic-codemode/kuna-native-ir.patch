+fn page_copy(s: &Spaces, reg: u64) -> Vec<FullOp> {
+    vec![op(
+        OpCode::CPUI_COPY,
+        Some(vn(&s.reg, reg, 8)),
+        vec![vn(&s.konst, 0xb0000, 8)],
+    )]
+}
+fn page_add(s: &Spaces, source: u64, output: u64, width: u32) -> Vec<FullOp> {
+    vec![op(
+        OpCode::CPUI_INT_ADD,
+        Some(vn(&s.reg, output, width)),
+        vec![vn(&s.reg, source, 8), vn(&s.konst, 0x468, 8)],
+    )]
+}
+fn begin_page(pp: &mut PcRelativeValues, s: &Spaces) {
+    let ops = page_copy(s, 0x4030);
+    let seed = PcPageCopy::candidate(&ops, Some(&s.ram))
+        .unwrap()
+        .for_mnemonic("ADRP");
+    assert!(pp
+        .step(
+            Instruction {
+                vma: 0x2574c,
+                len: 4,
+                ops: &ops,
+                pc_page: seed
+            },
+            None,
+            &[(0xb0000, 0xb2000)],
+            Some(&s.ram)
+        )
+        .is_empty());
+}
+fn advance(
+    pp: &mut PcRelativeValues,
+    s: &Spaces,
+    vma: u64,
+    ops: &[FullOp],
+) -> Vec<(u64, XrefKind)> {
+    pp.step(
+        Instruction {
+            vma,
+            len: 4,
+            ops,
+            pc_page: None,
+        },
+        None,
+        &[(0xb0000, 0xb2000)],
+        Some(&s.ram),
+    )
+}
