+        begin_page(&mut pp, &s);
+        let mut ops = vec![op(
+            OpCode::CPUI_INT_ADD,
+            Some(vn(&s.uniq, 0x10, 8)),
+            vec![vn(&s.reg, 0x4030, 8), vn(&s.konst, 0x468, 8)],
+        )];
+        ops.push(op(
+            opcode,
+            if opcode == OpCode::CPUI_LOAD {
+                Some(vn(&s.reg, 0x4040, 8))
+            } else {
+                None
+            },
+            if opcode == OpCode::CPUI_LOAD {
+                vec![vn(&s.konst, ram_id(&s), 8), vn(&s.uniq, 0x10, 8)]
+            } else {
+                vec![
+                    vn(&s.konst, ram_id(&s), 8),
+                    vn(&s.uniq, 0x10, 8),
+                    vn(&s.reg, 0, 8),
