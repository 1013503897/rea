+struct BoundedString {
+    text: String,
+    limit: usize,
+}
+
+impl Write for BoundedString {
+    fn write_str(&mut self, value: &str) -> fmt::Result {
+        let next = self.text.len().checked_add(value.len()).ok_or(fmt::Error)?;
+        if next > self.limit {
+            return Err(fmt::Error);
+        }
+        if next > self.text.capacity() {
+            let capacity = next
+                .max(self.text.capacity().saturating_mul(2))
+                .min(self.limit);
+            self.text
+                .try_reserve_exact(capacity - self.text.len())
+                .map_err(|_| fmt::Error)?;
+        }
+        self.text.push_str(value);
+        Ok(())
+    }
+}
+
+pub(super) fn render_bounded(value: &Json, format: Format, limit: usize) -> Option<String> {
+    let mut out = BoundedString {
+        text: String::new(),
+        limit,
+    };
+    write_value(&mut out, value, 0, format).ok()?;
+    Some(out.text)
+}
